<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="06/06/2026 00:00:00" ReportInfo.Modified="06/06/2026 00:00:00" ReportInfo.CreatorVersion="2020.2.6.0">
  <ScriptText>using System;
using System.Collections.Generic;
using System.Reflection;
using FastReport;
using FastReport.Data;&#xD;&#xA;using FastReport.Table;

namespace FastReport
{
  public class ReportScript
  {
    private class ProductStat
    {
      public string Uid;
      public decimal Quantity;
      public decimal Sum;
      public decimal Average;
      public decimal Variation;
      public string Xyz = &quot;&quot;;
      public readonly Dictionary&lt;DateTime, decimal&gt; PeriodSums = new Dictionary&lt;DateTime, decimal&gt;();
    }

    private enum PeriodGranularity
    {
      Day,
      Week,
      Month
    }

    private bool _analyticsReady;
    private int _periodCount = 1;
    private PeriodGranularity _periodGranularity;
    private DateTime _reportStart;
    private const decimal XyzXLimit = 10m;
    private const decimal XyzYLimit = 25m;
    private readonly Dictionary&lt;string, ProductStat&gt; _stats = new Dictionary&lt;string, ProductStat&gt;();

    public string BuildAnalytics()
    {
      if (_analyticsReady)
        return &quot;&quot;;

      var dateStart = ((DateTime)Report.GetParameterValue(&quot;DateStartReport&quot;)).Date;
      var dateFinish = ((DateTime)Report.GetParameterValue(&quot;DateFinishReport&quot;)).Date;
      _periodGranularity = GetPeriodGranularity(dateStart, dateFinish);
      _reportStart = dateStart;
      _periodCount = GetCompletePeriodCount(dateStart, dateFinish);
      if (_periodCount == 0)
      {
        _analyticsReady = true;
        return &quot;&quot;;
      }
      var lastPeriodExclusive = AddPeriods(_reportStart, _periodCount);

      var data = Report.GetDataSource(&quot;items&quot;);
      data.Init();

      while (data.HasMoreRows)
      {
        var row = data.CurrentRow;
        var uid = Convert.ToString(GetValue(row, &quot;Good.Uid&quot;));
        if (String.IsNullOrEmpty(uid))
        {
          data.Next();
          continue;
        }

        ProductStat stat;
        if (!_stats.TryGetValue(uid, out stat))
        {
          stat = new ProductStat { Uid = uid };
          _stats.Add(uid, stat);
        }

        var sum = ToDecimalValue(GetValue(row, &quot;Sum&quot;));
        var date = GetPeriodStart(((DateTime)GetValue(row, &quot;DocumentDate&quot;)).Date);
        if (date &lt; _reportStart || date &gt;= lastPeriodExclusive)
        {
          data.Next();
          continue;
        }
        stat.Quantity += ToDecimalValue(GetValue(row, &quot;Quantity&quot;));
        stat.Sum += sum;

        if (!stat.PeriodSums.ContainsKey(date))
          stat.PeriodSums.Add(date, 0m);
        stat.PeriodSums[date] += sum;

        data.Next();
      }

      var excludedUids = new List&lt;string&gt;();
      foreach (var pair in _stats)
        if (pair.Value.Quantity == 0m)
          excludedUids.Add(pair.Key);
      foreach (var uid in excludedUids)
        _stats.Remove(uid);

      foreach (var stat in _stats.Values)
      {
        stat.Average = stat.Sum / _periodCount;
        if (stat.Average == 0)
        {
          stat.Variation = 0;
          stat.Xyz = &quot;Z&quot;;
          continue;
        }

        var variance = 0d;
        for (var i = 0; i &lt; _periodCount; i++)
        {
          var date = AddPeriods(_reportStart, i);
          decimal value;
          stat.PeriodSums.TryGetValue(date, out value);
          var delta = (double)(value - stat.Average);
          variance += delta * delta;
        }

        var std = Math.Sqrt(variance / _periodCount);
        stat.Variation = (decimal)std / Math.Abs(stat.Average) * 100m;
        stat.Xyz = stat.Variation &lt;= XyzXLimit ? &quot;X&quot; : stat.Variation &lt;= XyzYLimit ? &quot;Y&quot; : &quot;Z&quot;;
      }

      _analyticsReady = true;
      return &quot;&quot;;
    }

    public string XyzClass(int dummy)
    {
      return XyzClass(CurrentGoodUid());
    }

    public string XyzClass(object uid)
    {
      BuildAnalytics();
      var stat = Find(uid);
      return stat == null ? &quot;&quot; : stat.Xyz;
    }

    public decimal XyzAverage(int dummy)
    {
      return XyzAverage(CurrentGoodUid());
    }

    public decimal XyzAverage(object uid)
    {
      BuildAnalytics();
      var stat = Find(uid);
      return stat == null ? 0m : Math.Round(stat.Average, 2);
    }

    public decimal XyzVariation(int dummy)
    {
      return XyzVariation(CurrentGoodUid());
    }

    public decimal XyzVariation(object uid)
    {
      BuildAnalytics();
      var stat = Find(uid);
      return stat == null ? 0m : Math.Round(stat.Variation, 2);
    }

    public int XyzSort(int dummy)
    {
      return XyzSort(CurrentGoodUid());
    }

    public int XyzSort(object uid)
    {
      var xyz = XyzClass(uid);
      return xyz == &quot;X&quot; ? 1 : xyz == &quot;Y&quot; ? 2 : 3;
    }

    public decimal XyzLimitX(int dummy)
    {
      return XyzXLimit;
    }

    public decimal XyzLimitY(int dummy)
    {
      return XyzYLimit;
    }

    public decimal SoldQuantity(int dummy)
    {
      BuildAnalytics();
      var stat = Find(CurrentGoodUid());
      return stat == null ? 0m : stat.Quantity;
    }

    public void GroupFooter1_BeforePrint(object sender, EventArgs e)
    {
      GroupFooter1.Visible = SoldQuantity(0) != 0m;
    }
    private object CurrentGoodUid()
    {
      return Report.GetColumnValue(&quot;items.Good.Uid&quot;);
    }

    private ProductStat Find(object uid)
    {
      ProductStat stat;
      return _stats.TryGetValue(Convert.ToString(uid), out stat) ? stat : null;
    }

    private PeriodGranularity GetPeriodGranularity(DateTime dateStart, DateTime dateFinish)
    {
      var days = (dateFinish - dateStart).Days + 1;
      return days &lt;= 31 ? PeriodGranularity.Day : days &lt;= 183 ? PeriodGranularity.Week : PeriodGranularity.Month;
    }

    private DateTime GetPeriodStart(DateTime date)
    {
      if (_periodGranularity == PeriodGranularity.Day)
        return date.Date;

      if (_periodGranularity == PeriodGranularity.Week)
        return _reportStart.AddDays((date.Date - _reportStart).Days / 7 * 7);

      var periodStart = _reportStart;
      while (periodStart.AddMonths(1) &lt;= date)
        periodStart = periodStart.AddMonths(1);
      return periodStart;
    }

    private int GetCompletePeriodCount(DateTime dateStart, DateTime dateFinish)
    {
      var days = (dateFinish - dateStart).Days + 1;
      if (_periodGranularity == PeriodGranularity.Day)
        return days;

      if (_periodGranularity == PeriodGranularity.Week)
        return days / 7;

      var count = 0;
      while (dateStart.AddMonths(count + 1) &lt;= dateFinish.AddDays(1))
        count++;
      return count;
    }

    private DateTime AddPeriods(DateTime firstPeriod, int index)
    {
      if (_periodGranularity == PeriodGranularity.Day)
        return firstPeriod.AddDays(index);

      if (_periodGranularity == PeriodGranularity.Week)
        return firstPeriod.AddDays(index * 7);

      return firstPeriod.AddMonths(index);
    }

    private static object GetValue(object source, string path)
    {
      var value = source;
      foreach (var part in path.Split(new char[] { Convert.ToChar(46) }))
      {
        if (value == null)
          return null;

        var property = value.GetType().GetProperty(part, BindingFlags.Instance | BindingFlags.Public);
        value = property == null ? null : property.GetValue(value, null);
      }

      return value;
    }

    private static decimal ToDecimalValue(object value)
    {
      return value == null ? 0m : Convert.ToDecimal(value);
    }
  }
}
</ScriptText>
  <Dictionary>
    <BusinessObjectDataSource Name="items" ReferenceName="items" DataType="null" Enabled="true">
      <Column Name="Good" DataType="null">
        <Column Name="Uid" DataType="System.Guid"/>
        <Column Name="Name" DataType="System.String"/>
        <Column Name="Group" DataType="null">
          <Column Name="Name" DataType="System.String"/>
        </Column>
        <Column Name="Barcode" DataType="System.String"/>
      </Column>
      <Column Name="Quantity" DataType="System.Decimal"/>
      <Column Name="Sum" DataType="System.Decimal"/>
      <Column Name="DocumentDate" DataType="System.DateTime"/>
    </BusinessObjectDataSource>
    <Parameter Name="CompanyName" DataType="System.String"/>
    <Parameter Name="CompanyInfo" DataType="System.String"/>
    <Parameter Name="DateStartReport" DataType="System.DateTime"/>
    <Parameter Name="DateFinishReport" DataType="System.DateTime"/>
    <Total Name="TotalCountGroup" Expression="[items.Quantity]" Evaluator="Data1" PrintOn="GroupFooter1"/>
    <Total Name="TotalSumGroup" Expression="[items.Sum]" Evaluator="Data1" PrintOn="GroupFooter1"/>
    <Total Name="TotalCount" Expression="[items.Quantity]" Evaluator="Data1"/>
    <Total Name="TotalSum" Expression="[items.Sum]" Evaluator="Data1"/>
  </Dictionary>
