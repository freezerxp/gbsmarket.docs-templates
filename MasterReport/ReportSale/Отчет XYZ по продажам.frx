          <TableCell Name="Cell26" Border.Lines="All" Text="Выручка" HorzAlign="Center" VertAlign="Center" Font="Arial, 10pt, style=Bold"/>
          <TableCell Name="Cell29" Border.Lines="All" Text="Средн. за период" HorzAlign="Center" VertAlign="Center" Font="Arial, 10pt, style=Bold"/>
          <TableCell Name="Cell31" Border.Lines="All" Text="CV, %" HorzAlign="Center" VertAlign="Center" Font="Arial, 10pt, style=Bold"/>
