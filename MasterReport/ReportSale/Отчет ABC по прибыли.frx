      <TableObject Name="Table2" Left="9.45" Width="1011.15" Height="37.8">
        <TableColumn Name="Column6" Width="47.25"/>
        <TableColumn Name="Column7" Width="113.4"/>
        <TableColumn Name="Column8" Width="113.4"/>
        <TableColumn Name="Column19" Width="302.4"/>
