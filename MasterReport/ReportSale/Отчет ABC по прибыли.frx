          <TableCell Name="TotalCell6" Border.Lines="All" Text="[TotalSum]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" Font="Arial, 10pt, style=Bold"/>
          <TableCell Name="TotalCell7" Border.Lines="All" Text="[TotalIncome]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" Font="Arial, 10pt, style=Bold"/>
