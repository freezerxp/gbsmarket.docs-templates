          <TableCell Name="Cell20" Border.Lines="All" Text="Продано" HorzAlign="Center" VertAlign="Center" Font="Arial, 10pt, style=Bold"/>
          <TableCell Name="Cell26" Border.Lines="All" Text="Выручка" HorzAlign="Center" VertAlign="Center" Font="Arial, 10pt, style=Bold"/>
          <TableCell Name="Cell29" Border.Lines="All" Text="Прибыль" HorzAlign="Center" VertAlign="Center" Font="Arial, 10pt, style=Bold"/>
          <TableCell Name="Cell31" Border.Lines="All" Text="Доля&#xD;&#xA;прибыли, %" HorzAlign="Center" VertAlign="Center" Font="Arial, 10pt, style=Bold"/>
          <TableCell Name="Cell32" Border.Lines="All" Text="ABC по&#xD;&#xA;прибыли" HorzAlign="Center" VertAlign="Center" Font="Arial, 10pt, style=Bold"/>
        </TableRow>
      </TableObject>
    </PageHeaderBand>
    <GroupHeaderBand Name="GroupHeader1" Top="143.26" Width="1047.06" Height="37.8" CanShrink="true" Condition="[items.Good.Uid]" SortOrder="None">
      <DataBand Name="Data1" Top="186.54" Width="1047.06" Height="18.9" CanGrow="true" CanShrink="true" DataSource="items" Filter="SoldQuantity(0) != 0">
        <Sort>
          <Sort Expression="AbcSort(0)"/>&#xD;&#xA;          <Sort Expression="AbcProfit(0)" Descending="true"/>&#xD;&#xA;          <Sort Expression="[items.Good.Name]"/>
        </Sort>
      </DataBand>
      <GroupFooterBand Name="GroupFooter1" BeforePrintEvent="GroupFooter1_BeforePrint" Top="210.92" Width="1047.06" Height="18.9" CanGrow="true">
        <TableObject Name="Table1" Left="9.45" Width="1011.15" Height="18.9" CanBreak="false" RepeatHeaders="false">
          <TableColumn Name="Column1" Width="47.25"/>
          <TableColumn Name="Column2" Width="113.4"/>
          <TableColumn Name="Column3" Width="113.4"/>
          <TableColumn Name="Column21" Width="302.4"/>
          <TableColumn Name="Column22" Width="75.6"/>
          <TableColumn Name="Column28" Width="94.5"/>
          <TableColumn Name="Column30" Width="94.5"/>
          <TableColumn Name="Column33" Width="94.5"/>
          <TableColumn Name="Column34" Width="75.6"/>
          <TableRow Name="Row1" MaxHeight="75.6" AutoSize="true">
            <TableCell Name="Cell1" Border.Lines="All" Text="[Row#]" HorzAlign="Center" Font="Arial, 10pt"/>
            <TableCell Name="Cell2" Border.Lines="All" Text="[items.Good.Barcode]" Font="Arial, 10pt"/>
            <TableCell Name="Cell3" Border.Lines="All" Text="[items.Good.Group.Name]" Font="Arial, 10pt"/>
            <TableCell Name="Cell21" Border.Lines="All" Text="[items.Good.Name]" Font="Arial, 10pt"/>
            <TableCell Name="Cell22" Border.Lines="All" Text="[TotalCountGroup]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" Font="Arial, 10pt"/>
            <TableCell Name="Cell28" Border.Lines="All" Text="[TotalSumGroup]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" Font="Arial, 10pt"/>
            <TableCell Name="Cell30" Border.Lines="All" Text="[TotalIncomeGroup]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" Font="Arial, 10pt"/>
            <TableCell Name="Cell33" Border.Lines="All" Text="[AbcShare(0)]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Right" Font="Arial, 10pt"/>
            <TableCell Name="Cell34" Border.Lines="All" Text="[AbcClass(0)]" HorzAlign="Center" Font="Arial, 10pt, style=Bold"/>
          </TableRow>
        </TableObject>
      </GroupFooterBand>
    </GroupHeaderBand>
    <ReportSummaryBand Name="ReportSummary1" Top="235.3" Width="1047.06" Height="28.35">
      <TableObject Name="TableTotal" Left="9.45" Top="0" Width="1011.15" Height="18.9">
